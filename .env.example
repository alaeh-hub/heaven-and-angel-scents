SECRET_KEY=change-this-to-a-random-string
APP_ENV=development
FLASK_DEBUG=0
# Idle session timeout in hours.
SESSION_IDLE_HOURS=8
# "json" (production default) or "text".
LOG_FORMAT=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=heaven_and_angel_scents

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

AI_CHAT_RATE_LIMIT=15 per minute;150 per day

# Partner portal: private link protected only by this slug.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(16))"
# Blank in dev auto-generates a temporary slug; required in production.
# Link: https://yourdomain.com/partner-portal/<slug>/packages
PARTNER_PORTAL_SLUG=

# 1 only behind nginx/Caddy (real visitor IP for rate limits); 0 for local dev.
TRUST_PROXY=0

# Portal contact details (optional; blank is hidden).
#   VIBER: digits with country code, e.g. 639171234567
#   MESSENGER_URL: e.g. https://m.me/yourpage
#   REPLY_TIME: completes "We reply ...", e.g. within 1 business day
PORTAL_CONTACT_PHONE=
PORTAL_CONTACT_EMAIL=
PORTAL_CONTACT_VIBER=
PORTAL_CONTACT_MESSENGER_URL=
PORTAL_REPLY_TIME=

# Outbound SMTP mail: inquiry alerts and backup emails. Blank disables email
# (inquiries are still saved).
# Gmail: turn on 2-Step Verification, then create an App password and use it
# as MAIL_PASSWORD. MAIL_USERNAME/MAIL_DEFAULT_SENDER is the sending address;
# PARTNER_INQUIRY_NOTIFY_EMAIL is the inbox for new leads.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PARTNER_INQUIRY_NOTIFY_EMAIL=
# Backup email recipient (defaults to the inquiry address if blank).
BACKUP_NOTIFY_EMAIL=
BACKUP_EMAIL_MAX_MB=18
# Passphrase (12+ chars) encrypting the emailed .enc backup. Required to send.
BACKUP_ZIP_PASSWORD=
# 0 stops this process from running scheduled backups.
BACKUP_SCHEDULER=1
# Dev only: send one backup at this business time, e.g. 2026-11-11 16:30.
BACKUP_TEST_RUN_AT=

# Dev only: shows Admin > Clear Data. Forced off in production.
ALLOW_DATA_RESET=0

# --- Docker deployment (docker-compose.yml) ---
# Compose overrides MYSQL_HOST/USER/PASSWORD; MYSQL_* above is for non-Docker runs.
# Public domain Caddy serves (A record must point at the server):
DOMAIN=
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_ROOT_PASSWORD=
DB_APP_USER=heaven_app
DB_APP_PASSWORD=
BACKUP_RETENTION_DAYS=14
# Optional URL pinged after each good daily backup (e.g. healthchecks.io).
BACKUP_HEARTBEAT_URL=

# --- Connection pool ---
# MYSQL_POOL_SIZE=20            # max 32
# MYSQL_POOL_WAIT_SECONDS=5     # wait for a free connection before answering 503

# --- Off-host backups: `docker compose --profile offsite up -d` ---
# OFFSITE_DEST=offsite:my-bucket/heaven-angel
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# OFFSITE_HEARTBEAT_URL=
