# Local configuration and secrets
.env
.env.*
!.env.example
rclone.conf

# Python environments and caches
.venv/
venv/
.ruff_cache/
__pycache__/
*.py[cod]

# Local runtime data
*.log
*.db
*.sqlite
*.sqlite3
instance/

# Local test artifacts
test_logo.pdf

# Uploaded product images stay local and are not committed
static/uploads/

# Portal dependencies and build output (rebuilt on deploy)
public-site/node_modules/
static/public-site/

# Local tooling and test output
.pytest_cache/
.coverage
htmlcov/
check/

# Local design/media drafts
# Raw brand sources; the app uses only the cut files (favicon-*, pwa/icon-*, etc.)
static/img/icon.png
static/img/new_wordmark.png
static/img/background*.png
static/img/background*.mp4
static/video/white_background*.mp4

# IDE and local tool metadata
.vscode/
.idea/
.agents/
.claude/
.hallmark/
.mcp.json
skills-lock.json
caddy-local-root.crt

# Local media assets and generated files
static/video/*.mp4
# ...except the small clip the public site plays (keep it web-sized)
!static/video/craft-perfume.mp4

# Mascot source art; only the built atlases in static/mascots/ are needed
characters/

# Full-size product renders; the app uses the cuts in static/img/scents/
assets/scent-renders/

# Local database backup archives and restore safety copies (never commit)
backups/

# Generated local test output
*.pdf
coverage.xml

# Promo video generation workspace (local only)
promo-video/

# One-off opening data import scripts (local only)
scripts/import_opening_*.py

# Product catalogue exports (re-importable CSV downloads)
products_*.csv

# Temp schema copy written by tests (a crashed run can leave it)
_test_schema_*.sql

# Private keys and certificates: never commit
*.pem
*.key

# OS folder metadata
desktop.ini
Thumbs.db
.DS_Store

# Backup archives and DB dumps (schema.sql is the only .sql in git)
*.sql.gz
*.tar.gz
heaven-angel-backup-*.zip
before-restore-*.zip
before_*_import_*.sql

# Certificates and private working folders
certs/
docs/private/

# Editor and temp leftovers
*.bak
*.tmp
*.swp

# Encrypted backup wrappers and passphrase notes
*-encrypted.zip
backup-passphrase*
.env.local

# Reference photos of the printed price boards (local only)
/image.png
/image copy.png
