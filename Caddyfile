# Caddy: automatic HTTPS for $DOMAIN, proxies to the app (WebSockets included).
{
	# Serve the $DOMAIN cert to clients that connect by IP (LAN testing).
	default_sni {$DOMAIN}

	# Trust X-Forwarded-For from private-network proxies only (real client IPs).
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode gzip zstd
	reverse_proxy web:8000
}
